# DataPilot environment template.
# Copy to .env and fill in keys you have. The Settings → Models screen (Phase 11)
# will overwrite these with safeStorage-encrypted values entered in the UI.

# LLM providers (any subset)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Local Llama via Ollama (host-side; the FastAPI container will reach this
# at host.docker.internal:11434 on macOS/Windows, or the host gateway on Linux)
OLLAMA_HOST=http://host.docker.internal:11434

# Neo4j (passwords baked into docker-compose.yml have this default)
NEO4J_PASSWORD=datapilot-local

# Optional rerank for the retrieve_logs RAG tool (Phase 4.5)
COHERE_API_KEY=
VOYAGE_API_KEY=
